# Google Ads Configuration
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CLIENT_ID=your_client_id
GOOGLE_ADS_CLIENT_SECRET=your_client_secret
GOOGLE_ADS_REFRESH_TOKEN=your_refresh_token
GOOGLE_ADS_CUSTOMER_ID=1234567890
GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890

# Telegram Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_chat_id
AUTHORIZED_USERS=123456789,987654321  # Comma-separated Telegram user IDs (leave empty to allow only TELEGRAM_CHAT_ID)

# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/google_ads

# Alert Settings
DEFAULT_DAILY_THRESHOLD=1000.00

# Timezone
TIMEZONE=America/New_York

# Logging
LOG_LEVEL=INFO
